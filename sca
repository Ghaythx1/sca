def count_netis_clients(page):
    """Prefer DHCP leases; fall back to valid ARP entries."""
    dhcp = json_array(page, "dhcp_client_list")
    if dhcp is not None:
        active = [c for c in dhcp
                  if not isinstance(c, dict)
                  or c.get("status", "1") in ("1", 1, True)]
        return len(active)

    arp = json_array(page, "arp_list")
    if arp is not None:
        valid = [c for c in arp
                 if not isinstance(c, dict)
                 or c.get("arp_st", "0x2") in ("0x2", 2)]
        return len(valid)
    return None


def fetch_netis(ip):
    best = None
    for path in ("/cgi-bin/netcore_get.cgi", "/netcore_get.cgi"):
        for attempt in range(1, 4):
            page = run_curl([
                "curl", "-s", "--connect-timeout", "1.0", "--max-time", "5.0",
                "-d", "mode_name=netcore_get&no=no",
                f"http://{ip}{path}",
            ])
            ssid = clean(json_str(page, "ssid"))
            if not ssid:
                break

            pwd = None
            for key in ("key_wpa", "wsc_psk", "wds_key_wpa", "key_wep"):
                pwd = clean(json_str(page, key))
                if pwd:
                    break

            active = 0
            for lan in ("lan1", "lan2", "lan3", "lan4"):
                val = json_str(page, lan)
                if val and val.isdigit():
                    active += int(val)
            traffic = f"{active} Active LAN" if active else "0 / 0"
            best = (ssid, traffic, active > 0, pwd or "N/A",
                    count_netis_clients(page))
            if pwd:
                return best
            time.sleep(0.12 * attempt)
        if best and best[3] != "N/A":
            return best
    return best


