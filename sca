def fetch_tenda_clients(ip):
    """Tenda exposes an unauthenticated client list on some firmwares."""
    for path in ("/goform/getWifiClientList", "/goform/getClientList",
                 "/goform/getOnlineClientList", "/goform/WifiClientList"):
        page = run_curl([
            "curl", "-s", "--connect-timeout", "0.8", "--max-time", "3.0",
            f"http://{ip}{path}",
        ])
        if not page or page.lstrip()[:1] not in ("{", "["):
            continue
        try:
            data = json.loads(page)
        except Exception:
            for key in ("clientList", "client_list", "clientlist",
                        "onlineList", "list", "data"):
                arr = json_array(page, key)
                if arr is not None:
                    return len(arr)
            continue
        if isinstance(data, list):
            return len(data)
        if isinstance(data, dict):
            for key in ("clientList", "client_list", "clientlist",
                        "onlineList", "list", "data"):
                val = data.get(key)
                if isinstance(val, list):
                    return len(val)
    return None


def fetch_tenda(ip):
    page = run_curl([
        "curl", "-s", "--connect-timeout", "0.8", "--max-time", "2.0",
        f"http://{ip}/goform/WifiBasicGet",
    ])
    ssid = clean(json_str(page, "ssid"))
    if not ssid:
        return None
    pwd = None
    for key in ("wifiPwd", "wifiPass", "password", "wpa_key"):
        pwd = clean(json_str(page, key))
        if pwd:
            break
    return ssid, "0 / 0", False, pwd or "N/A", fetch_tenda_clients(ip)


