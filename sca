def fetch_realtek_ssid(ip):
    for attempt in range(1, 4):
        page = run_curl([
            "curl", "-s", "--connect-timeout", "0.8", "--max-time", "2.5",
            f"http://{ip}/wlbasic.htm",
        ])
        if page:
            m = re.search(r'ssid_2g\s*[:=]\s*["\']?([^"\'\r\n;<>]+)', page)
            if not m:
                m = re.search(r'\bssid\s*[:=]\s*["\']?([^"\'\r\n;<>]+)',
                              page, re.I)
            if m:
                val = clean(m.group(1))
                if val and val.lower() not in ("null", "undefined"):
                    return val
            # page answered but is not a Realtek AP -> no point retrying
            return None
        time.sleep(0.10 * attempt)
    return None


def fetch_traffic(ip):
    for attempt in range(1, 4):
        page = run_curl([
            "curl", "-s", "--connect-timeout", "0.8", "--max-time", "2.0",
            f"http://{ip}/stats.htm",
        ])
        mtx = re.search(r'(?:lanTx|lan_tx|lanTxPacket)\s*[:=]\s*["\']?(\d+)', page)
        mrx = re.search(r'(?:lanRx|lan_rx|lanRxPacket)\s*[:=]\s*["\']?(\d+)', page)
        if mtx and mrx:
            return mtx.group(1), mrx.group(1)
        time.sleep(0.10 * attempt)
    return "0", "0"


def fetch_realtek_clients(ip):
    """Count associated wireless clients from status.htm.

    Realtek reports one counter for each radio (clientnum), one for each
    virtual AP (mssid_clientnum) and one for a repeater interface
    (rp_clientnum).  Each is a separate SSID, so they are summed.
    """
    for attempt in range(1, 3):
        page = run_curl([
            "curl", "-s", "--connect-timeout", "1.5", "--max-time", "12.0",
            f"http://{ip}/status.htm",
        ])
        if page:
            main = re.findall(
                r"(?<![A-Za-z0-9_])clientnum\[\d+\]\s*=\s*['\"]?(\d+)", page)
            mssid = re.findall(
                r"mssid_clientnum\[\d+\]\[\d+\]\s*=\s*['\"]?(\d+)", page)
            rp = re.findall(
                r"rp_clientnum\[\d+\]\s*=\s*['\"]?(\d+)", page)
            if main or mssid or rp:
                total = sum(map(int, main + mssid + rp))
                return total
        time.sleep(0.15 * attempt)
    return None


def fetch_realtek_password(ip):
    """Prefer the raw field: wps_psk_old (unmask_old can be HTML-escaped)."""
    for attempt in range(1, 5):
        page = run_curl([
            "curl", "-s", "--connect-timeout", "0.8", "--max-time", "3.0",
            f"http://{ip}/wlsecurity_all.htm",
        ])
        if page:
            m = re.search(r"wps_psk_old\s*=\s*'([^']*)'", page)
            if not m:
                m = re.search(r"wps_psk_unmask_old\s*=\s*'([^']*)'", page)
            if not m:
                m = re.search(r'pskValue1\.value\s*=\s*"([^"]*)"', page)
            if m:
                val = clean(m.group(1))
                if val:
                    return val
        time.sleep(0.12 * attempt)
    return None


