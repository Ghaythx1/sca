# --------------------------------------------------------------------------
# Terminal-width aware formatting (Arabic / emoji safe)
# --------------------------------------------------------------------------
def disp_w(text):
    """Display width in terminal cells."""
    if _wcswidth is not None:
        w = _wcswidth(text)
        if w >= 0:
            return w
    w = 0
    for ch in text:
        if unicodedata.combining(ch) or ch in ("\u200e", "\u200f",
                                               "\u202a", "\u202b", "\u202c",
                                               "\u2066", "\u2067", "\u2069"):
            continue
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def pad(text, width):
    text = str(text)
    return text + " " * max(0, width - disp_w(text))


def clip(text, width):
    """Truncate to `width` cells without splitting combining marks."""
    if disp_w(text) <= width:
        return text
    out, w = [], 0
    for ch in text:
        cw = disp_w(ch)
        if w + cw > width - 1:
            break
        out.append(ch)
        w += cw
    return "".join(out) + "…"


_ARABIC_RE = re.compile(r"[\u0600-\u06ff\u0750-\u077f\u08a0-\u08ff"
                        r"\ufb50-\ufdff\ufe70-\ufeff]")


def shape_arabic(text):
    """Make Arabic readable on a terminal that has no BiDi support.

    Reshaping produces the connected letter forms and get_display() puts
    them in visual order (right-to-left), which is what QTerminal prints.
    """
    text = str(text)
    if (arabic_reshaper is None or _bidi_display is None
            or not _ARABIC_RE.search(text)):
        return text
    try:
        return _bidi_display(arabic_reshaper.reshape(text))
    except Exception:
        return text


# --------------------------------------------------------------------------
# Helpers
# --------------------------------------------------------------------------
def run_curl(args):
    try:
        r = subprocess.run(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            errors="ignore",
        )
        return r.stdout
    except Exception:
        return ""


def is_host_alive(ip, timeout=0.35):
    """Fast check: TCP port 80 first, then a short ping."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            if s.connect_ex((ip, 80)) == 0:
                return True
    except Exception:
        pass
    try:
        res = subprocess.run(
            ["ping", "-c", "1", "-W", str(timeout), ip],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return res.returncode == 0
    except Exception:
        return False


def json_str(payload, key):
    m = re.search(r'"%s"\s*:\s*"([^"]*)"' % re.escape(key), payload)
    return m.group(1) if m else None


def json_array(payload, key):
    """Extract a JSON array stored under `key` from a router response."""
    m = re.search(r'"%s"\s*:\s*(\[[^\]]*\])' % re.escape(key), payload)
    if not m:
        return None
    try:
        value = json.loads(m.group(1))
    except Exception:
        return None
    return value if isinstance(value, list) else None


def clean(value):
    if value is None:
        return None
    value = html.unescape(value).replace("\\'", "'").strip()
    return value or None


